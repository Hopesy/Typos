# ==========================================
# 数据库配置
# ==========================================

# Cloudflare D1（生产）：无需 DATABASE_URL，通过 wrangler.jsonc 的 DB binding 使用。

# 本地 libSQL（开发）：未配置 DATABASE_URL 时自动使用 ./data/typos.db。
# 也可以显式写成：DATABASE_URL=file:./data/typos.db

# Turso/libSQL（远程）：
# DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your_token_here

# ==========================================
# 管理员配置（必需）
# ==========================================

# Admin dashboard password. No default is provided.
ADMIN_PASSWORD=

# Session signing secret. Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

